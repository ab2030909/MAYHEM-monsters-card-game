# Cloudinary — copy this file to `.env.local` and fill in your values.
# Only public values belong here. NEVER put your Cloudinary API secret in a VITE_ variable.
VITE_CLOUDINARY_CLOUD_NAME=
# An UNSIGNED upload preset (Settings → Upload → Upload presets).
# Restrict it: allowed formats jpg,png,webp,gif · max file size 10MB · folder "monstersnap".
VITE_CLOUDINARY_UPLOAD_PRESET=
